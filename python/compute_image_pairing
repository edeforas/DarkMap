        image1=cv2.imread(all_images[i])
        image2=cv2.imread(all_images[j])
        F,err=compute_fundamental_matrix(image1,image2)

        all_err[i,j]=err
        print (f'Image1={all_images[i]} Image2={all_images[j]} F={F} Error={err}')

all_err=np.round(all_err, 2)    
